+/// Host-owned policy checked immediately before derived file reads.
+pub trait ReadPolicy: std::fmt::Debug + Send + Sync {
+    fn resolve(&self, path: &Path) -> io::Result<PathBuf>;
+}
+
 impl Context {
+    pub fn set_read_policy(&mut self, policy: std::sync::Arc<dyn ReadPolicy>) {
+        self.read_policy = Some(policy);
+    }
+
+    pub fn resolve_read_path(&self, path: &Path) -> io::Result<PathBuf> {
+        match &self.read_policy {
+            Some(policy) => policy
+                .resolve(path)
+                .inspect_err(|_| self.read_denied.set(true)),
+            None => Ok(path.to_owned()),
+        }
+    }
+
+    pub fn read_denied(&self) -> bool {
+        self.read_denied.get()
+    }
