# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf

# Cross-platform source, automation, and documentation stay byte-stable in CI.
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.sh text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
# Unified-diff context lines prefix source indentation and blank lines with a space.
*.patch text eol=lf whitespace=-space-before-tab,-blank-at-eol
*.dm text eol=lf
*.dme text eol=lf
*.dmm text eol=lf
*.dmf text eol=lf

# Generated byte-for-byte from the Rust contract registry.
docs/tool-contracts.md text eol=lf
